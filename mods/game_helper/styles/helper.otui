      anchors.left: heal1Slot.right
      margin-left: 6
    RTCCheck
      id: heal1Box
      anchors.verticalCenter: heal1Slot.verticalCenter
      anchors.left: heal1Hp.right
      margin-left: 6
      width: 16
    RTCInfo
      id: heal1Info
      anchors.verticalCenter: heal1Slot.verticalCenter
      anchors.left: heal1Box.right
      margin-left: 2
      tooltip: Cast these words when your health drops to the set percent.
    TextEdit
      id: heal1Words
      anchors.verticalCenter: heal1Slot.verticalCenter
      anchors.left: heal1Info.right
      margin-left: 6
      width: 116
      height: 18

    RTCSpellSlot
