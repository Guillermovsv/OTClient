    // --- stance (right column)
    VerticalSeparator
      id: casterSep
      anchors.top: colSpell.top
      anchors.bottom: atk5Slot.bottom
      anchors.left: parent.left
      margin-left: 380

    RTCColumnLabel
      id: stanceTitle
      anchors.top: presetCombo.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 8
      text: Stance

    // Every stance from every vocation is listed here; helper.lua fills the
    // grid and keeps exactly one selected.
    Panel
      id: stanceGrid
      anchors.top: stanceTitle.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 6
      size: 190 76

    // --- rune (right column)
    RTCColumnLabel
      id: runeTitle
      anchors.top: stanceGrid.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 10
      text: Rune
    RTCColumnLabel
      id: runeColCreatures
      anchors.top: runeTitle.top
      anchors.left: parent.left
      margin-left: 452
      text: Creatures
    RTCColumnLabel
      id: runeColPriority
      anchors.top: runeTitle.top
      anchors.left: parent.left
      margin-left: 528
      text: Priority

    RTCSlot
      id: runeSlot
      anchors.top: runeTitle.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 6
    ComboBox
      id: runeMobs
      anchors.verticalCenter: runeSlot.verticalCenter
      anchors.left: parent.left
      margin-left: 452
      width: 62
      height: 20
    ComboBox
