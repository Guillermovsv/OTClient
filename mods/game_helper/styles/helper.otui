      anchors.left: stance1Slot.right
      margin-left: 8

    // --- rune (right column)
    RTCColumnLabel
      id: runeTitle
      anchors.top: stance1Slot.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 14
      text: Rune
    RTCColumnLabel
      id: runeColCreatures
      anchors.top: runeTitle.top
      anchors.left: parent.left
      margin-left: 494
      text: Creatures
    RTCColumnLabel
      id: runeColPriority
      anchors.top: runeTitle.top
      anchors.left: parent.left
      margin-left: 578
      text: Priority

    RTCSlot
      id: runeSlot
      anchors.top: runeTitle.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 6
    ComboBox
      id: runeMobs
      anchors.verticalCenter: runeSlot.verticalCenter
      anchors.left: parent.left
      margin-left: 494
      width: 62
      height: 20
    ComboBox
      id: runePrio
      anchors.verticalCenter: runeSlot.verticalCenter
      anchors.left: parent.left
      margin-left: 578
      width: 62
      height: 20
    RTCCheck
      id: runeBox
      anchors.verticalCenter: runeSlot.verticalCenter
      anchors.left: parent.left
      margin-left: 650
      width: 16

    // --- toggles
    RTCCheck
      id: comboOrderBox
      anchors.top: runeSlot.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 16
      width: 230
      text: Combo in priority order

    RTCCheck
      id: hotkeyPriorityBox
      anchors.top: comboOrderBox.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 4
      width: 230
      text: Hotkey has priority

    RTCCheck
      id: autoTargetBox
      anchors.top: hotkeyPriorityBox.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 4
      width: 150
      text: Auto Target

    RTCInfo
      id: autoTargetInfo
      anchors.verticalCenter: autoTargetBox.verticalCenter
      anchors.left: autoTargetBox.right
      tooltip: Attack the nearest monster when you have no target.

    RTCCheck
      id: shooterBox
      anchors.top: autoTargetBox.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 4
      width: 150
      text: Enable Shooter Helper

    RTCInfo
      id: shooterInfo
      anchors.verticalCenter: shooterBox.verticalCenter
      anchors.left: shooterBox.right
      tooltip: Cast the attack spells above at your current target.

    RTCSmallButton
      id: targetKeyBtn
      anchors.top: shooterBox.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 8
      width: 218
      text: Set Key (Target / Shooter)
      @onClick: modules.game_helper.setTargetKey()

  // ------------------------------------------------------------ bottom bar
  Panel
    id: bottomBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 26

    RTCSmallButton
      id: helperKeyBtn
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      width: 110
      text: Set Helper Key
      @onClick: modules.game_helper.setHelperKey()

    RTCSmallButton
      id: exportBtn
      anchors.left: helperKeyBtn.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      width: 80
      text: Export
      @onClick: modules.game_helper.exportConfig()

    RTCSmallButton
      id: importBtn
      anchors.left: exportBtn.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      width: 80
      text: Import
      @onClick: modules.game_helper.importConfig()

    RTCSmallButton
      id: closeButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 70
      text: Close
      @onClick: modules.game_helper.hide()

    RTCSmallButton
      id: statsButton
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      width: 100
      text: Helper Stats
      @onClick: modules.game_helper.showStats()

    RTCSmallButton
      id: saveButton
      anchors.right: statsButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      width: 70
      text: Save
      @onClick: modules.game_helper.saveFromUI()
