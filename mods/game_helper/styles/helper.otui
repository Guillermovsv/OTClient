    // Rows 1-2 are health potions, row 3 is a mana potion.
    RTCSlot
      id: pot1Slot
      anchors.top: potHealTitle.bottom
      anchors.left: parent.left
      margin-left: 322
      margin-top: 8
    RTCStepper
      id: pot1Hp
      anchors.verticalCenter: pot1Slot.verticalCenter
      anchors.left: pot1Slot.right
      margin-left: 6
    RTCCheck
