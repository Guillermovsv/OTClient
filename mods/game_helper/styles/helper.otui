      id: rune2Box
      anchors.verticalCenter: rune2Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 600
      width: 16

    // --- toggles
    RTCCheck
      id: comboOrderBox
      anchors.top: rune2Slot.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 10
      width: 230
      text: Combo in priority order

    RTCCheck
      id: hotkeyPriorityBox
      anchors.top: comboOrderBox.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 2
      width: 230
      text: Hotkey has priority

    RTCCheck
      id: autoTargetBox
      anchors.top: hotkeyPriorityBox.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 2
      width: 186
      text: Auto Target

    RTCInfo
      id: autoTargetInfo
      anchors.verticalCenter: autoTargetBox.verticalCenter
      anchors.left: autoTargetBox.right
      tooltip: Attack the nearest monster when you have no target.

    RTCCheck
      id: shooterBox
      anchors.top: autoTargetBox.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 2
      width: 186
      text: Enable Shooter Helper

    RTCInfo
      id: shooterInfo
      anchors.verticalCenter: shooterBox.verticalCenter
      anchors.left: shooterBox.right
      tooltip: Cast the attack spells above at your current target.

    RTCSmallButton
      id: targetKeyBtn
      anchors.top: shooterBox.bottom
      anchors.left: parent.left
      margin-left: 400
      margin-top: 6
      width: 200
      text: Set Key (Target / Shooter)
      @onClick: modules.game_helper.setTargetKey()

  // ------------------------------------------------------------ bottom bar
  Panel
    id: bottomBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30

    RTCSmallButton
      id: helperKeyBtn
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 4
      width: 110
      text: Set Helper Key
      @onClick: modules.game_helper.setHelperKey()

    RTCSmallButton
      id: exportBtn
      anchors.left: helperKeyBtn.right
      anchors.top: helperKeyBtn.top
      margin-left: 6
      width: 80
      text: Export
      @onClick: modules.game_helper.exportConfig()

    RTCSmallButton
      id: importBtn
      anchors.left: exportBtn.right
      anchors.top: helperKeyBtn.top
      margin-left: 6
      width: 80
      text: Import
      @onClick: modules.game_helper.importConfig()

    RTCSmallButton
      id: closeButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      width: 70
      text: Close
      @onClick: modules.game_helper.hide()

    RTCSmallButton
      id: statsButton
      anchors.right: closeButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      width: 100
      text: Helper Stats
      @onClick: modules.game_helper.showStats()

    RTCSmallButton
      id: saveButton
      anchors.right: statsButton.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      width: 70
      text: Save
      @onClick: modules.game_helper.saveFromUI()
