// RTC Helper window.
// Layout follows the reference helper: a tab strip across the top, a titled
// sidebar panel on the left, a framed content panel on the right, and a button
// bar pinned to the bottom. Every interactive id here is read by helper.lua.

RTCSectionLabel < Label
  font: verdana-11px-rounded
  color: #c8a45c
  text-auto-resize: true

RTCColumnLabel < Label
  font: verdana-11px-rounded
  color: #c8a45c
  text-auto-resize: true

RTCValueLabel < Label
  font: verdana-11px-rounded
  color: #dfdfdf
  text-auto-resize: true

RTCCheck < CheckBox
  height: 16
  font: verdana-11px-rounded

// Empty slots show a dotted placeholder, like the reference. helper.lua hides
// the placeholder as soon as something is bound to the slot.
RTCSlot < Item
  size: 34 34
  virtual: true

  Label
    id: placeholder
    anchors.fill: parent
    text: . . . .
    text-align: center
    font: verdana-11px-rounded
    color: #6a6a6a
    phantom: true

// One stance in the stance grid. The selected one carries a yellow border.
RTCStanceSlot < UIWidget
  size: 34 34
  image-source: /images/ui/item
  image-border: 1
  focusable: false

  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 32 32
    image-source: /images/game/spells/spell-icons-32x32
    phantom: true

  $on:
    border-width: 2
    border-color: #ffd700

// Spell slots draw from the spell atlas by clientId rather than holding an
// item, so they cannot be UIItem. Clicking one opens the spell picker.
RTCSpellSlot < UIWidget
  size: 34 34
  image-source: /images/ui/item
  image-border: 1

  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 32 32
    image-source: /images/game/spells/spell-icons-32x32
    visible: false
    phantom: true

  Label
    id: placeholder
    anchors.fill: parent
    text: . . . .
    text-align: center
    font: verdana-11px-rounded
    color: #6a6a6a
    phantom: true

RTCTabButton < Button
  size: 40 34
  icon-size: 28 28
  icon-offset: 4 1

RTCSmallButton < Button
  height: 20
  font: verdana-11px-rounded

// Small round information marker, matching the (i) badges in the reference.
RTCInfo < Button
  size: 14 14
  text: i
  font: verdana-11px-rounded
  color: #9fb4c8

RTCSep < HorizontalSeparator
  height: 2

// A percent stepper: [<] [ nn ] % [>]
// The % is its own label rather than part of the spin box text, which only
// accepts digits.
RTCStepper < UIWidget
  size: 60 20
  Button
    id: dec
    text: <
    width: 8
    height: 18
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
  SpinBox
    id: spin
    width: 23
    height: 18
    text-align: center
    anchors.left: dec.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    // UISpinBox.create() defaults to maximum 1 and setValue() clamps, so a
    // percent written before the range is widened silently becomes 1.
    minimum: 0
    maximum: 100
    buttons: false
  Label
    id: pct
    text: '%'
    width: 10
    height: 18
    text-align: left
    font: verdana-11px-rounded
    color: #c8c8c8
    anchors.left: spin.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    phantom: true
  Button
    id: inc
    text: >
    width: 8
    height: 18
    anchors.left: pct.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

// Spell chooser, styled like the spell list / hotkey assignment: icon on the
// left, spell name and words beside it.
RTCSpellPickerRow < Label
  font: verdana-11px-monochrome
  background-color: alpha
  text-offset: 42 3
  focusable: true
  height: 36
  image-clip: 0 0 32 32
  image-size: 32 32
  image-offset: 2 2
  image-source: /images/game/spells/spell-icons-32x32

  $focus:
    background-color: #ffffff22
    color: #ffffff

// A name in the party-member list.
RTCFriendRow < Label
  font: verdana-11px-rounded
  background-color: alpha
  color: #dfdfdf
  focusable: true
  height: 16
  text-align: left
  text-offset: 4 1

  $focus:
    background-color: #ffffff22
    color: #ffffff

RTCSpellPickerWindow < MainWindow
  id: spellPicker
  !text: tr('Select Spell')
  size: 360 420

  TextList
    id: pickerList
    vertical-scrollbar: pickerScroll
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: pickerSelect.top
    margin-bottom: 8
    margin-right: 14
    padding: 1
    focusable: false

  VerticalScrollBar
    id: pickerScroll
    anchors.top: pickerList.top
    anchors.bottom: pickerList.bottom
    anchors.right: parent.right
    step: 36
    pixels-scroll: true

  Button
    id: pickerSelect
    !text: tr('Select')
    anchors.left: parent.left
    anchors.bottom: parent.bottom
    width: 90
    height: 22

  Button
    id: pickerCancel
    !text: tr('Cancel')
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    width: 90
    height: 22

MainWindow
  id: helperWindow
  size: 900 474
  text: RTC Helper
  visible: false
  @onEscape: modules.game_helper.hide()

  // ------------------------------------------------------------- tab strip
  FlatPanel
    id: tabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40

    RTCTabButton
      id: healingTabBtn
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 4
      icon: /images/topbuttons/healthinfo
      tooltip: Healing
      @onClick: modules.game_helper.selectTab('healing')

    RTCTabButton
      id: casterTabBtn
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: healingTabBtn.right
      margin-left: 3
      icon: /images/topbuttons/combatcontrols
      tooltip: RTCaster
      @onClick: modules.game_helper.selectTab('caster')

    Label
      id: tabTitle
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: casterTabBtn.right
      margin-left: 14
      font: verdana-11px-rounded
      color: #ffffff
      text: Healing
      text-auto-resize: true

  // ---------------------------------------------------------------- sidebar
  MiniPanel
    id: sidebar
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.bottom: bottomBar.top
    width: 214
    margin-top: 6
    margin-bottom: 6
    text: -
    text-align: top
    text-offset: 0 4

    UICreature
      id: charPreview
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 22
      size: 64 64
      image-source: /images/ui/panel_flat
      image-border: 1
      fixed-creature-size: true

    RTCValueLabel
      id: presetLabel
      anchors.top: charPreview.bottom
      anchors.left: parent.left
      margin-top: 10
      text: Preset: Default

    RTCValueLabel
      id: statusLabel
      anchors.top: presetLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      color: #cc4444
      text: Helper Status: Disabled

    RTCCheck
      id: enableBox
      anchors.top: statusLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 170
      text: Helper Enabled

    RTCSep
      id: sideSep1
      anchors.top: enableBox.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

    RTCSectionLabel
      id: hasteTitle
      anchors.top: sideSep1.bottom
      anchors.left: parent.left
      margin-top: 8
      text: Auto Haste

    RTCSpellSlot
      id: hasteSlot
      anchors.top: hasteTitle.bottom
      anchors.left: parent.left
      margin-top: 6

    RTCCheck
      id: autoHasteBox
      anchors.top: hasteSlot.top
      anchors.left: hasteSlot.right
      margin-left: 10
      width: 110
      text: Enable

    RTCCheck
      id: hastePzBox
      anchors.top: autoHasteBox.bottom
      anchors.left: hasteSlot.right
      margin-left: 10
      margin-top: 2
      width: 110
      text: PZ Cast


    RTCSep
      id: sideSep2
      anchors.top: hasteSlot.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    RTCSectionLabel
      id: toolsTitle
      anchors.top: sideSep2.bottom
      anchors.left: parent.left
      margin-top: 8
      text: Others Tools

    RTCInfo
      id: toolsInfo
      anchors.verticalCenter: toolsTitle.verticalCenter
      anchors.left: toolsTitle.right
      margin-left: 6
      tooltip: Convenience tools that run while the helper is enabled.

    RTCCheck
      id: changeGoldBox
      anchors.top: toolsTitle.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 176
      text: Change Gold

    RTCCheck
      id: autoEatBox
      anchors.top: changeGoldBox.bottom
      anchors.left: parent.left
      margin-top: 3
      width: 176
      text: Auto Eat Food

    RTCCheck
      id: autoReconnectBox
      anchors.top: autoEatBox.bottom
      anchors.left: parent.left
      margin-top: 3
      width: 176
      text: Auto Reconnect


    // bound hotkeys, pinned to the bottom so the sidebar reads as full
    RTCSep
      id: sideSep3
      anchors.top: autoReconnectBox.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

    RTCSectionLabel
      id: keysTitle
      anchors.top: sideSep3.bottom
      anchors.left: parent.left
      margin-top: 6
      text: Hotkeys

    RTCValueLabel
      id: helperKeyLabel
      anchors.top: keysTitle.bottom
      anchors.left: parent.left
      margin-top: 3
      text: Helper: none

    RTCValueLabel
      id: targetKeyLabel
      anchors.top: helperKeyLabel.bottom
      anchors.left: parent.left
      margin-top: 2
      text: Target / Shooter: none

  // --------------------------------------------------------- healing panel
  // Cloned from the reference: three columns over a rule, then two friend
  // groups, each a name list beside two Sio rows.
  FlatPanel
    id: healingPanel
    anchors.top: tabBar.bottom
    anchors.left: sidebar.right
    anchors.right: parent.right
    anchors.bottom: bottomBar.top
    margin-left: 6
    margin-top: 6
    margin-bottom: 6
    padding: 10

    // ---- Spell Healing
    RTCColumnLabel
      id: spellHealTitle
      anchors.top: parent.top
      anchors.left: parent.left
      text: Spell Healing

    RTCSpellSlot
      id: heal1Slot
      anchors.top: spellHealTitle.bottom
      anchors.left: parent.left
      margin-top: 6
    RTCStepper
      id: heal1Hp
      anchors.verticalCenter: heal1Slot.verticalCenter
      anchors.left: heal1Slot.right
      margin-left: 6
    RTCInfo
      id: heal1Info
      anchors.verticalCenter: heal1Slot.verticalCenter
      anchors.left: heal1Hp.right
      margin-left: 6
      tooltip: Cast this spell when your health drops to the set percent.

    RTCSpellSlot
      id: heal2Slot
      anchors.top: heal1Slot.bottom
      anchors.left: parent.left
      margin-top: 6
    RTCStepper
      id: heal2Hp
      anchors.verticalCenter: heal2Slot.verticalCenter
      anchors.left: heal2Slot.right
      margin-left: 6
    RTCInfo
      id: heal2Info
      anchors.verticalCenter: heal2Slot.verticalCenter
      anchors.left: heal2Hp.right
      margin-left: 6
      tooltip: Cast this spell when your health drops to the set percent.

    RTCSpellSlot
      id: heal3Slot
      anchors.top: heal2Slot.bottom
      anchors.left: parent.left
      margin-top: 6
    RTCStepper
      id: heal3Hp
      anchors.verticalCenter: heal3Slot.verticalCenter
      anchors.left: heal3Slot.right
      margin-left: 6
    RTCInfo
      id: heal3Info
      anchors.verticalCenter: heal3Slot.verticalCenter
      anchors.left: heal3Hp.right
      margin-left: 6
      tooltip: Cast this spell when your health drops to the set percent.

    VerticalSeparator
      id: healSepA
      anchors.top: spellHealTitle.top
      anchors.bottom: heal3Slot.bottom
      anchors.left: parent.left
      margin-left: 136

    // ---- Potion Healing
    RTCColumnLabel
      id: potHealTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 156
      text: Potion Healing

    RTCSlot
      id: pot1Slot
      anchors.top: potHealTitle.bottom
      anchors.left: parent.left
      margin-left: 156
      margin-top: 6
    RTCStepper
      id: pot1Hp
      anchors.verticalCenter: pot1Slot.verticalCenter
      anchors.left: pot1Slot.right
      margin-left: 6
    RTCInfo
      id: pot1Info
      anchors.verticalCenter: pot1Slot.verticalCenter
      anchors.left: pot1Hp.right
      margin-left: 6
      tooltip: Drag or pick a potion. Red drinks on health, blue on mana - click to switch.

    RTCSlot
      id: pot2Slot
      anchors.top: pot1Slot.bottom
      anchors.left: parent.left
      margin-left: 156
      margin-top: 6
    RTCStepper
      id: pot2Hp
      anchors.verticalCenter: pot2Slot.verticalCenter
      anchors.left: pot2Slot.right
      margin-left: 6
    RTCInfo
      id: pot2Info
      anchors.verticalCenter: pot2Slot.verticalCenter
      anchors.left: pot2Hp.right
      margin-left: 6
      tooltip: Drag or pick a potion. Red drinks on health, blue on mana - click to switch.

    RTCSlot
      id: pot3Slot
      anchors.top: pot2Slot.bottom
      anchors.left: parent.left
      margin-left: 156
      margin-top: 6
    RTCStepper
      id: pot3Mana
      anchors.verticalCenter: pot3Slot.verticalCenter
      anchors.left: pot3Slot.right
      margin-left: 6
    RTCInfo
      id: pot3Info
      anchors.verticalCenter: pot3Slot.verticalCenter
      anchors.left: pot3Mana.right
      margin-left: 6
      tooltip: Drag or pick a potion. Red drinks on health, blue on mana - click to switch.

    VerticalSeparator
      id: healSepB
      anchors.top: spellHealTitle.top
      anchors.bottom: heal3Slot.bottom
      anchors.left: parent.left
      margin-left: 292

    // ---- Mana Training
    RTCColumnLabel
      id: manaTrainTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 312
      text: Mana Training

    RTCSpellSlot
      id: manaTrainSlot
      anchors.top: manaTrainTitle.bottom
      anchors.left: parent.left
      margin-left: 312
      margin-top: 6
    RTCCheck
      id: manaTrainBox
      anchors.top: manaTrainSlot.top
      anchors.left: manaTrainSlot.right
      margin-left: 8
      margin-top: 1
      width: 90
      text: Enable
    ComboBox
      id: manaTrainPct
      anchors.top: manaTrainBox.bottom
      anchors.left: manaTrainSlot.right
      margin-left: 8
      margin-top: 3
      width: 66
      height: 20
    RTCInfo
      id: manaTrainInfo
      anchors.verticalCenter: manaTrainPct.verticalCenter
      anchors.left: manaTrainPct.right
      margin-left: 6
      tooltip: Cast this spell in a protection zone while mana is at or above the set percent.

    // ---- Exercise Training
    RTCColumnLabel
      id: exTrainTitle
      anchors.top: manaTrainSlot.bottom
      anchors.left: parent.left
      margin-left: 312
      margin-top: 10
      text: Exercise Training

    RTCSlot
      id: exTrainSlot
      anchors.top: exTrainTitle.bottom
      anchors.left: parent.left
      margin-left: 312
      margin-top: 6
    RTCCheck
      id: exTrainBox
      anchors.top: exTrainSlot.top
      anchors.left: exTrainSlot.right
      margin-left: 8
      margin-top: 1
      width: 90
      text: Enable
    ComboBox
      id: exTrainPct
      anchors.top: exTrainBox.bottom
      anchors.left: exTrainSlot.right
      margin-left: 8
      margin-top: 3
      width: 66
      height: 20
      enabled: false

    RTCSep
      id: healSep
      // Anchored to the spell column, which is the tallest of the three: the
      // training column ends higher, so hanging the rule off it put the line
      // hard against the bottom row.
      anchors.top: heal3Slot.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 18

    // ---- Sio friend group
    RTCColumnLabel
      id: friendTitle
      anchors.top: healSep.bottom
      anchors.left: parent.left
      margin-top: 18
      text: Select a Friend
    RTCInfo
      id: friendInfo
      anchors.verticalCenter: friendTitle.verticalCenter
      anchors.left: friendTitle.right
      margin-left: 6
      tooltip: Party members on screen. Pick one, then press + on a row.

    TextList
      id: friendList
      vertical-scrollbar: friendScroll
      anchors.top: friendTitle.bottom
      anchors.left: parent.left
      height: 74
      margin-top: 4

      width: 116
      padding: 1
      focusable: false
    VerticalScrollBar
      id: friendScroll
      anchors.top: friendList.top
      anchors.bottom: friendList.bottom
      anchors.left: friendList.right
      step: 16
      pixels-scroll: true

    RTCColumnLabel
      id: sioTitle
      anchors.top: healSep.bottom
      anchors.left: parent.left
      margin-left: 140
      margin-top: 18
      text: Sio Friend List

    RTCSmallButton
      id: sio1Set
      anchors.top: sioTitle.bottom
      anchors.left: parent.left
      margin-left: 140
      margin-top: 6
      width: 28
      height: 40
      text: +
      tooltip: Bind the friend selected on the left to this row
    RTCCheck
      id: sio1Box
      anchors.top: sio1Set.top
      anchors.left: sio1Set.right
      margin-left: 6
      width: 108
      text: Enable Sio
    ComboBox
      id: sio1Pct
      anchors.top: sio1Box.bottom
      anchors.left: sio1Set.right
      margin-left: 6
      margin-top: 2
      width: 66
      height: 20
    RTCInfo
      id: sio1Info
      anchors.verticalCenter: sio1Pct.verticalCenter
      anchors.left: sio1Pct.right
      margin-left: 6
      tooltip: Cast Heal Friend on this player when their health drops to the set percent.
    RTCValueLabel
      id: sio1Name
      anchors.top: sio1Set.bottom
      anchors.left: parent.left
      margin-left: 140
      margin-top: 2
      text: -

    RTCSmallButton
      id: sio2Set
      anchors.top: sio1Name.bottom
      anchors.left: parent.left
      margin-left: 140
      margin-top: 6
      width: 28
      height: 40
      text: +
      tooltip: Bind the friend selected on the left to this row
    RTCCheck
      id: sio2Box
      anchors.top: sio2Set.top
      anchors.left: sio2Set.right
      margin-left: 6
      width: 108
      text: Enable Sio
    ComboBox
      id: sio2Pct
      anchors.top: sio2Box.bottom
      anchors.left: sio2Set.right
      margin-left: 6
      margin-top: 2
      width: 66
      height: 20
    RTCInfo
      id: sio2Info
      anchors.verticalCenter: sio2Pct.verticalCenter
      anchors.left: sio2Pct.right
      margin-left: 6
      tooltip: Cast Heal Friend on this player when their health drops to the set percent.
    RTCValueLabel
      id: sio2Name
      anchors.top: sio2Set.bottom
      anchors.left: parent.left
      margin-left: 140
      margin-top: 2
      text: -

    // ---- Gran Sio friend group
    RTCColumnLabel
      id: friend2Title
      anchors.top: healSep.bottom
      anchors.left: parent.left
      margin-left: 300
      margin-top: 18
      text: Select a Friend
    RTCInfo
      id: friend2Info
      anchors.verticalCenter: friend2Title.verticalCenter
      anchors.left: friend2Title.right
      margin-left: 6
      tooltip: Party members on screen. Pick one, then press + on a row.

    TextList
      id: friend2List
      vertical-scrollbar: friend2Scroll
      anchors.top: friend2Title.bottom
      anchors.left: parent.left
      height: 74
      margin-left: 300
      margin-top: 4

      width: 116
      padding: 1
      focusable: false
    VerticalScrollBar
      id: friend2Scroll
      anchors.top: friend2List.top
      anchors.bottom: friend2List.bottom
      anchors.left: friend2List.right
      step: 16
      pixels-scroll: true

    RTCColumnLabel
      id: granSioTitle
      anchors.top: healSep.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 18
      text: Gran Sio Friend List

    RTCSmallButton
      id: sio3Set
      anchors.top: granSioTitle.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 6
      width: 28
      height: 40
      text: +
      tooltip: Bind the friend selected on the left to this row
    RTCCheck
      id: sio3Box
      anchors.top: sio3Set.top
      anchors.left: sio3Set.right
      margin-left: 6
      width: 108
      text: Enable
    ComboBox
      id: sio3Pct
      anchors.top: sio3Box.bottom
      anchors.left: sio3Set.right
      margin-left: 6
      margin-top: 2
      width: 66
      height: 20
    RTCInfo
      id: sio3Info
      anchors.verticalCenter: sio3Pct.verticalCenter
      anchors.left: sio3Pct.right
      margin-left: 6
      tooltip: Cast the stronger heal on this player when their health drops to the set percent.
    RTCValueLabel
      id: sio3Name
      anchors.top: sio3Set.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 2
      text: -

    RTCSmallButton
      id: sio4Set
      anchors.top: sio3Name.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 6
      width: 28
      height: 40
      text: +
      tooltip: Bind the friend selected on the left to this row
    RTCCheck
      id: sio4Box
      anchors.top: sio4Set.top
      anchors.left: sio4Set.right
      margin-left: 6
      width: 108
      text: Enable
    ComboBox
      id: sio4Pct
      anchors.top: sio4Box.bottom
      anchors.left: sio4Set.right
      margin-left: 6
      margin-top: 2
      width: 66
      height: 20
    RTCInfo
      id: sio4Info
      anchors.verticalCenter: sio4Pct.verticalCenter
      anchors.left: sio4Pct.right
      margin-left: 6
      tooltip: Cast the stronger heal on this player when their health drops to the set percent.
    RTCValueLabel
      id: sio4Name
      anchors.top: sio4Set.bottom
      anchors.left: parent.left
      margin-left: 440
      margin-top: 2
      text: -

  FlatPanel
    id: casterPanel
    anchors.top: tabBar.bottom
    anchors.left: sidebar.right
    anchors.right: parent.right
    anchors.bottom: bottomBar.top
    margin-left: 6
    margin-top: 6
    margin-bottom: 6
    padding: 10
    visible: false

    // --- presets
    RTCSectionLabel
      id: presetsLabel
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 4
      text: Presets:

    RTCInfo
      id: presetsInfo
      anchors.verticalCenter: presetsLabel.verticalCenter
      anchors.left: presetsLabel.right
      margin-left: 6
      tooltip: Named copies of every helper setting.

    ComboBox
      id: presetCombo
      anchors.top: presetsLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 124
      height: 20

    RTCSmallButton
      id: presetDeleteBtn
      anchors.verticalCenter: presetCombo.verticalCenter
      anchors.left: presetCombo.right
      margin-left: 6
      width: 24
      text: X
      color: #cc4444
      tooltip: Delete the selected preset
      @onClick: modules.game_helper.deletePreset()

    RTCSmallButton
      id: presetRenameBtn
      anchors.top: parent.top
      anchors.left: presetCombo.right
      margin-left: 42
      width: 124
      text: Rename Preset
      @onClick: modules.game_helper.renamePreset()

    RTCSmallButton
      id: presetNewBtn
      anchors.top: presetRenameBtn.bottom
      anchors.left: presetCombo.right
      margin-left: 42
      margin-top: 4
      width: 124
      text: New Preset
      @onClick: modules.game_helper.newPreset()

    // --- attack column headers
    RTCColumnLabel
      id: colSpell
      anchors.top: presetCombo.bottom
      anchors.left: parent.left
      margin-top: 16
      text: Spell

    RTCColumnLabel
      id: colMana
      anchors.top: colSpell.top
      anchors.left: parent.left
      margin-left: 46
      text: Mana %

    RTCColumnLabel
      id: colCreatures
      anchors.top: colSpell.top
      anchors.left: parent.left
      margin-left: 142
      text: Creatures

    RTCColumnLabel
      id: colPriority
      anchors.top: colSpell.top
      anchors.left: parent.left
      margin-left: 218
      text: Priority

    // --- attack rows
    RTCSpellSlot
      id: atk1Slot
      anchors.top: colSpell.bottom
      anchors.left: parent.left
      margin-top: 6
    RTCStepper
      id: atk1Mana
      anchors.verticalCenter: atk1Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 46
    ComboBox
      id: atk1Mobs
      anchors.verticalCenter: atk1Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 142
      width: 62
      height: 20
    ComboBox
      id: atk1Prio
      anchors.verticalCenter: atk1Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 218
      width: 62
      height: 20
    RTCCheck
      id: atk1Box
      anchors.verticalCenter: atk1Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 288
      width: 16

    RTCSpellSlot
      id: atk2Slot
      anchors.top: atk1Slot.bottom
      anchors.left: parent.left
      margin-top: 6
    RTCStepper
      id: atk2Mana
      anchors.verticalCenter: atk2Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 46
    ComboBox
      id: atk2Mobs
      anchors.verticalCenter: atk2Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 142
      width: 62
      height: 20
    ComboBox
      id: atk2Prio
      anchors.verticalCenter: atk2Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 218
      width: 62
      height: 20
    RTCCheck
      id: atk2Box
      anchors.verticalCenter: atk2Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 288
      width: 16

    RTCSpellSlot
      id: atk3Slot
      anchors.top: atk2Slot.bottom
      anchors.left: parent.left
      margin-top: 6
    RTCStepper
      id: atk3Mana
      anchors.verticalCenter: atk3Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 46
    ComboBox
      id: atk3Mobs
      anchors.verticalCenter: atk3Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 142
      width: 62
      height: 20
    ComboBox
      id: atk3Prio
      anchors.verticalCenter: atk3Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 218
      width: 62
      height: 20
    RTCCheck
      id: atk3Box
      anchors.verticalCenter: atk3Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 288
      width: 16

    RTCSpellSlot
      id: atk4Slot
      anchors.top: atk3Slot.bottom
      anchors.left: parent.left
