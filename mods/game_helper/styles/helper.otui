// RTC Helper window.
// Layout follows the reference helper: a tab strip across the top, a titled
// sidebar panel on the left, a framed content panel on the right, and a button
// bar pinned to the bottom. Every interactive id here is read by helper.lua.

RTCSectionLabel < Label
  font: verdana-11px-rounded
  color: #c8a45c
  text-auto-resize: true

RTCColumnLabel < Label
  font: verdana-11px-rounded
  color: #c8a45c
  text-auto-resize: true

RTCValueLabel < Label
  font: verdana-11px-rounded
  color: #dfdfdf
  text-auto-resize: true

RTCCheck < CheckBox
  height: 16
  font: verdana-11px-rounded

// Empty slots show a dotted placeholder, like the reference. helper.lua hides
// the placeholder as soon as something is bound to the slot.
RTCSlot < Item
  size: 34 34
  virtual: true

  Label
    id: placeholder
    anchors.fill: parent
    text: . . . .
    text-align: center
    font: verdana-11px-rounded
    color: #6a6a6a
    phantom: true

// Spell slots draw from the spell atlas by clientId rather than holding an
// item, so they cannot be UIItem. Clicking one opens the spell picker.
RTCSpellSlot < UIWidget
  size: 34 34
  image-source: /images/ui/item
  image-border: 1

  UIWidget
    id: icon
    anchors.centerIn: parent
    size: 32 32
    image-source: /images/game/spells/spell-icons-32x32
    visible: false
    phantom: true

  Label
    id: placeholder
    anchors.fill: parent
    text: . . . .
    text-align: center
    font: verdana-11px-rounded
    color: #6a6a6a
    phantom: true

RTCTabButton < Button
  size: 40 34
  icon-size: 28 28
  icon-offset: 4 1

RTCSmallButton < Button
  height: 20
  font: verdana-11px-rounded

// Small round information marker, matching the (i) badges in the reference.
RTCInfo < Button
  size: 14 14
  text: i
  font: verdana-11px-rounded
  color: #9fb4c8

RTCSep < HorizontalSeparator
  height: 2

// A percent stepper: [<] [ nn% ] [>]  (arrows are deliberately narrow)
RTCStepper < UIWidget
  size: 62 20
  Button
    id: dec
    text: <
    width: 5
    height: 18
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
  SpinBox
    id: spin
    width: 48
    height: 18
    anchors.left: dec.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1
    // UISpinBox.create() defaults to maximum 1 and setValue() clamps, so a
    // percent written before the range is widened silently becomes 1.
    minimum: 0
    maximum: 100
    buttons: false
  Button
    id: inc
    text: >
    width: 5
    height: 18
    anchors.left: spin.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 1

MainWindow
  id: helperWindow
  size: 900 474
  text: RTC Helper
  visible: false
  @onEscape: modules.game_helper.hide()

  // ------------------------------------------------------------- tab strip
  FlatPanel
    id: tabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 40

    RTCTabButton
      id: healingTabBtn
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: parent.left
      margin-left: 4
      icon: /images/topbuttons/healthinfo
      tooltip: Healing
      @onClick: modules.game_helper.selectTab('healing')

    RTCTabButton
      id: casterTabBtn
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: healingTabBtn.right
      margin-left: 3
      icon: /images/topbuttons/combatcontrols
      tooltip: RTCaster
      @onClick: modules.game_helper.selectTab('caster')

    Label
      id: tabTitle
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: casterTabBtn.right
      margin-left: 14
      font: verdana-11px-rounded
      color: #ffffff
      text: Healing
      text-auto-resize: true

  // ---------------------------------------------------------------- sidebar
  MiniPanel
    id: sidebar
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.bottom: bottomBar.top
    width: 214
    margin-top: 6
    margin-bottom: 6
    text: -
    text-align: top
    text-offset: 0 4

    UICreature
      id: charPreview
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      margin-top: 26
      size: 104 104
      image-source: /images/ui/panel_flat
      image-border: 1
      padding: 4

    RTCValueLabel
      id: presetLabel
      anchors.top: charPreview.bottom
      anchors.left: parent.left
      margin-top: 10
      text: Preset: Default

    RTCValueLabel
      id: statusLabel
      anchors.top: presetLabel.bottom
      anchors.left: parent.left
      margin-top: 4
      color: #cc4444
      text: Helper Status: Disabled

    RTCCheck
      id: enableBox
      anchors.top: statusLabel.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 170
      text: Helper Enabled

    RTCSep
      id: sideSep1
      anchors.top: enableBox.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8

    RTCSectionLabel
      id: hasteTitle
      anchors.top: sideSep1.bottom
      anchors.left: parent.left
      margin-top: 8
      text: Auto Haste

    RTCSpellSlot
      id: hasteSlot
      anchors.top: hasteTitle.bottom
      anchors.left: parent.left
      margin-top: 6

    RTCCheck
      id: autoHasteBox
      anchors.top: hasteSlot.top
      anchors.left: hasteSlot.right
      margin-left: 10
      width: 110
      text: Enable

    RTCCheck
      id: hastePzBox
      anchors.top: autoHasteBox.bottom
      anchors.left: hasteSlot.right
      margin-left: 10
      margin-top: 2
      width: 110
      text: PZ Cast

    TextEdit
      id: hasteWords
      anchors.top: hasteSlot.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 176
      height: 20

    RTCSep
      id: sideSep2
      anchors.top: hasteWords.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10

    RTCSectionLabel
      id: toolsTitle
      anchors.top: sideSep2.bottom
      anchors.left: parent.left
      margin-top: 8
      text: Others Tools

    RTCInfo
      id: toolsInfo
      anchors.verticalCenter: toolsTitle.verticalCenter
      anchors.left: toolsTitle.right
      margin-left: 6
      tooltip: Convenience tools that run while the helper is enabled.

    RTCCheck
      id: changeGoldBox
      anchors.top: toolsTitle.bottom
      anchors.left: parent.left
      margin-top: 6
      width: 176
      text: Change Gold

    RTCCheck
      id: autoEatBox
      anchors.top: changeGoldBox.bottom
      anchors.left: parent.left
      margin-top: 3
      width: 176
      text: Auto Eat Food

    RTCCheck
      id: autoReconnectBox
      anchors.top: autoEatBox.bottom
      anchors.left: parent.left
      margin-top: 3
      width: 176
      text: Auto Reconnect

    RTCValueLabel
      id: foodLabel
      anchors.top: autoReconnectBox.bottom
      anchors.left: parent.left
      margin-top: 8
      text: Food id:

    TextEdit
      id: foodItem
      anchors.verticalCenter: foodLabel.verticalCenter
      anchors.left: foodLabel.right
      margin-left: 6
      width: 74
      height: 20

    // bound hotkeys, pinned to the bottom so the sidebar reads as full
    RTCSep
      id: sideSep3
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: keysTitle.top
      margin-bottom: 8

    RTCSectionLabel
      id: keysTitle
      anchors.left: parent.left
      anchors.bottom: helperKeyLabel.top
      margin-bottom: 4
      text: Hotkeys

    RTCValueLabel
      id: helperKeyLabel
      anchors.left: parent.left
      anchors.bottom: targetKeyLabel.top
      margin-bottom: 3
      text: Helper: none

    RTCValueLabel
      id: targetKeyLabel
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-bottom: 8
      text: Target / Shooter: none

  // --------------------------------------------------------- healing panel
