      anchors.left: heal2Slot.right
      margin-left: 6
    RTCCheck
      id: heal2Box
      anchors.verticalCenter: heal2Slot.verticalCenter
      anchors.left: heal2Hp.right
      margin-left: 6
      width: 16
    RTCInfo
      id: heal2Info
      anchors.verticalCenter: heal2Slot.verticalCenter
      anchors.left: heal2Box.right
      margin-left: 2
      tooltip: Cast these words when your health drops to the set percent.
    TextEdit
      id: heal2Words
      anchors.verticalCenter: heal2Slot.verticalCenter
      anchors.left: heal2Info.right
      margin-left: 6
      width: 116
      height: 18

    RTCSpellSlot
      id: heal3Slot
      anchors.top: heal2Slot.bottom
      anchors.left: parent.left
      margin-top: 8
    RTCStepper
