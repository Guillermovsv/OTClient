    RTCCheck
      id: atk4Box
      anchors.verticalCenter: atk4Slot.verticalCenter
      anchors.left: parent.left
      margin-left: 288
      width: 16

    RTCSpellSlot
      id: atk5Slot
      anchors.top: atk4Slot.bottom
      anchors.left: parent.left
      margin-top: 6
    RTCStepper
      id: atk5Mana
      anchors.verticalCenter: atk5Slot.verticalCenter
      anchors.left: parent.left
